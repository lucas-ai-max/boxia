# Server
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (Supabase — Postgres com pgvector já disponível)
# Pegue em: Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use o "Transaction Pooler" (porta 6543) para apps serverless ou "Session Pooler" (porta 5432) para conexões longas.
# Exemplo: postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Auth
JWT_SECRET=troque-isto-em-producao
JWT_EXPIRES_IN=30d

# Google Gemini (motor de IA da BoxIA — pegue a chave em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview
GEMINI_EMBED_MODEL=gemini-embedding-001

# Storage (dev: filesystem)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_TTL_DAYS=7

# Limites
MAX_VIDEO_MB=500
MAX_VIDEO_MINUTES=15
MAX_PRINTS_PER_BATCH=50

# ClickUp — DEFAULT GLOBAL (modo "já conectado de fábrica" pra todos os users)
# ─────────────────────────────────────────────────────────────────────────────
# Setando os 2 envs abaixo, todo user já tem ClickUp "conectado" sem precisar
# OAuth — todos os approves caem na CLICKUP_DEFAULT_LIST_ID.
# 1. Pegue um Personal API Token: https://app.clickup.com → Settings → Apps → Generate
# 2. CLICKUP_DEFAULT_LIST_ID = o número depois de /li/ na URL da lista no ClickUp
#    Ex.: https://app.clickup.com/9011731314/v/l/li/901113714565 → 901113714565
CLICKUP_DEFAULT_TOKEN=
CLICKUP_DEFAULT_LIST_ID=
CLICKUP_DEFAULT_LIST_NAME=Lista padrão

# ClickUp — OAuth (opcional: cada user pode conectar sua própria conta como override)
# ─────────────────────────────────────────────────────────────────────────────
# Pegue em https://app.clickup.com/settings/team/<workspace-id>/apps
# Crie UM ÚNICO OAuth App ("BoxIA") e cadastre TODAS as Redirect URLs nele
# (dev + homolog + prod). Client ID/Secret são os mesmos — o que muda por
# ambiente é só CLICKUP_REDIRECT_URI e FRONTEND_URL aqui no .env.
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=

# Dev local:
CLICKUP_REDIRECT_URI=http://localhost:3333/clickup/oauth/callback
FRONTEND_URL=http://localhost:3000

# Homolog (exemplo — ajuste pros seus domínios):
# CLICKUP_REDIRECT_URI=https://boxia-api-staging.<seu-dominio>/clickup/oauth/callback
# FRONTEND_URL=https://boxia-staging.vercel.app

# Produção (VPS atual):
# CLICKUP_REDIRECT_URI=https://boxia-api.85.155.186.214.sslip.io/clickup/oauth/callback
# FRONTEND_URL=https://boxia.vercel.app
